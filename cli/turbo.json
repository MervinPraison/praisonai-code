{
	"$schema": "https://turbo.build/schema.json",
	"extends": ["//"],
	"tasks": {
		"clean": {
			"cache": false,
			"outputs": []
		},
		"clean:praisonaicode": {
			"outputs": ["dist/praisonaicode/**"],
			"inputs": ["../bin-unpacked/extension/**"],
			"dependsOn": ["clean"]
		},
		"copy:praisonaicode": {
			"outputs": ["dist/praisonaicode/**"],
			"inputs": ["../bin-unpacked/extension/**"],
			"dependsOn": ["clean:praisonaicode", "praisonai-code#vsix:unpacked"]
		},
		"build": {
			"cache": false,
			"outputs": ["dist/**"],
			"inputs": ["src/**"],
			"dependsOn": ["copy:praisonaicode"]
		},
		"start": {
			"cache": false,
			"dependsOn": ["build"]
		},
		"cli:bundle": {
			"cache": false,
			"outputs": ["dist/**"],
			"inputs": ["src/**", "package.dist.json", "esbuild.config.mjs"],
			"dependsOn": ["build", "deps:install"]
		},
		"deps:install": {
			"cache": false,
			"outputs": ["dist/node_modules/**"],
			"inputs": ["package.dist.json"],
			"dependsOn": ["build"]
		}
	}
}
